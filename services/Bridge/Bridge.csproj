<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bridge</RootNamespace>
    <AssemblyName>Bridge</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Confluent.Kafka" Version="2.15.0" />
    <PackageReference Include="Hl7.Fhir.R4" Version="5.13.4" />
    <!-- Exposes /metrics in the same shape prom-client gives the Node services,
         so Prometheus and Alloy scrape this the same way they scrape those. -->
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <!-- Verifies the estate's user tokens, and checks them against the same
         Redis session the Node services check. See Identity.cs. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.16.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.10.4" />
  </ItemGroup>

</Project>
