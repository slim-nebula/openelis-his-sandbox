# =============================================================================
# OpenELIS <-> HIS Sandbox : single source of externalised configuration
# =============================================================================
# Copy this to .env and fill in the marked values, or run `make secrets` to
# generate them. .env is NOT committed.
#
#   __GENERATE__   scripts/init-secrets.sh mints a random value here
#   __SET_ME__     you must supply this; nothing can guess it for you
#
# Values left as plain text below are not secrets: ports, topic names, hostnames
# and tuning parameters. They are safe to read, and safe to change.
#
# WHY THIS FILE EXISTS
# .env used to be committed with working credentials in it. That is defensible
# for a demo and indefensible for anything else, because the moment one real
# password is added it is in the history forever. Splitting the shape of the
# configuration (here, committed) from its values (.env, ignored) means adding
# a real credential no longer requires remembering to do anything.
# =============================================================================

COMPOSE_PROJECT_NAME=his-lab-sandbox
TZ=UTC

# --- Which OpenELIS to run ----------------------------------------------------
# OpenELIS is the accredited component, so it is the one thing in this stack
# that must never float. `:develop` moves without notice - the same tag gave us
# a different build on two consecutive days - which makes a defect impossible to
# attribute and a demonstration impossible to reproduce. Every other image here
# is already pinned; this pins the laboratory too.
#
# OE_VERSION is an official OpenELIS Global 2 release tag, published by DIGI-UW
# on Docker Hub and cut from a matching, non-draft GitHub release.
#
# OE_IMAGE_REPO selects WHOSE build of that version runs:
#   itechuw      stock, unmodified upstream        <- the default, and the
#                                                     baseline any patch is
#                                                     measured against
#   his-sandbox  our locally built patched images  (see openelis-patches/)
#
# Switching to the patched build is therefore a deliberate two-line edit, and
# `docker ps` always says which one is running.
OE_IMAGE_REPO=itechuw
OE_VERSION=3.2.2.0

# --- "External" database server: HIS estate -----------------------------------
# Runs in its own compose project + network (compose/data.yml), reachable only
# over the oe-data-net network. Nothing shares volumes with it.
HIS_DB_HOST=his-db.external
HIS_DB_PORT=5432
HIS_DB_ADMIN_USER=postgres
HIS_DB_ADMIN_PASSWORD=__GENERATE__

HIS_DB_NAME=his_sandbox
HIS_DB_USER=his_app
HIS_DB_PASSWORD=__GENERATE__

BRIDGE_DB_NAME=bridge_sandbox
BRIDGE_DB_USER=bridge_app
BRIDGE_DB_PASSWORD=__GENERATE__

# Host port for direct psql access during testing
HIS_DB_PUBLISHED_PORT=55432

# --- "External" database server: OpenELIS -------------------------------------
# These are read by the OpenELIS database image the first time its volume is
# initialised. Changing them against an existing volume will not rotate the
# password - it will just stop the webapp connecting.
OE_DB_HOST=openelis-db.external
OE_DB_PORT=5432
OE_DB_NAME=clinlims
OE_DB_USER=clinlims
OE_DB_PASSWORD=__GENERATE__
OE_DB_SUPERUSER_PASSWORD=__GENERATE__
OE_DB_PUBLISHED_PORT=15432

# --- Kafka --------------------------------------------------------------------
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_PUBLISHED_PORT=19092
TOPIC_ORDER_CREATED=lab.order.created
TOPIC_ORDER_SENT=lab.order.sent
# Where an order has got to inside the laboratory: accessioned, awaiting
# validation. A refinement under ACCEPTED_BY_LIS, not a replacement for it.
TOPIC_ORDER_PROGRESS=lab.order.progress
TOPIC_ORDER_FAILED=lab.order.failed
TOPIC_RESULT_RELEASED=lab.result.released
TOPIC_RESULT_FAILED=lab.result.failed

# How many brokers each topic is replicated across, and how many of those must
# acknowledge a write. The producers already use acks=all with idempotence, so
# these two numbers are the whole difference between "a broker dying loses
# nothing" and "a broker dying loses orders".
#
# 1 and 1 are the only values a single-broker sandbox can use. A real
# deployment runs at least three brokers and sets 3 and 2: writes survive one
# broker failing, and the cluster refuses writes it cannot make durable rather
# than accepting them and losing them.
KAFKA_REPLICATION_FACTOR=1
KAFKA_MIN_INSYNC_REPLICAS=1

# --- Service discovery + platform hooks --------------------------------------
# The real HIS registers every service with Consul and routes to
# <name>.service.consul. The sandbox runs its own Consul so the bridge and the
# HIS service exercise the same registration path they will use in production.
#
# Empty CONSUL_HOST disables registration; the services still start and still
# serve /health and /metrics.
# Kong resolves upstreams through Consul, and its dns_resolver takes an address
# rather than a name — so the sandbox network has an explicit subnet and Consul
# has a fixed address in it. The real HIS does the same thing (its CONSUL_HOST
# default is a fixed 10.10.0.12).
SANDBOX_SUBNET=172.30.0.0/16
CONSUL_IP=172.30.0.53
CONSUL_HOST=consul
CONSUL_PORT=8500
CONSUL_HTTP_PORT=8500
SERVICE_VERSION=1.0.0

# Shared log topic. Every service in the estate writes {service, level, message,
# timestamp} here; this is what the Node services' Winston Kafka transport uses.
TOPIC_LOGS=logs

# --- Edge ---------------------------------------------------------------------
# Reverse proxy is the only published entry point for the HIS sandbox.
EDGE_HTTP_PORT=8090
KONG_ADMIN_PORT=8001

# --- Service endpoints (internal) --------------------------------------------
HIS_API_INTERNAL_URL=http://his-api:8080
BRIDGE_INTERNAL_URL=http://bridge:8080

# Split into host and port. The estate passes REDIS_URL directly into ioredis's
# `host` option, which is a string — so `redis:6379` is resolved as a hostname,
# never connects, and leaves the service permanently in degraded authentication
# mode without saying so. Both services here parse either shape; these two are
# the ones that cannot be misread.
REDIS_HOST=redis
REDIS_PORT=6379

# --- User authentication ------------------------------------------------------
# The estate's IAM service signs user tokens with HS256 and this secret. Both
# services here only ever VERIFY — neither mints a token, because neither is
# IAM. In the sandbox, `make token` stands in for a login.
#
# HS256 means one shared string both signs and verifies. Every service holding
# it can therefore mint a token that every other service will accept, and IAM's
# payload carries no `aud`, so nothing scopes a token to one service. See
# docs/security.md; the fix belongs in IAM, not here.
#
# Unset means every authenticated endpoint answers 503. That is deliberate: a
# missing secret must never be the thing that lets requests through.
JWT_SECRET=__GENERATE__

# IAM group names required for the clinical API and for the bridge's /ops views.
# These are `group_names` claims, which IAM fills from a user's group
# memberships. Empty means any authenticated user passes; the values below are
# sandbox names, and a deployment replaces them with real ones.
#
# The check here is coarse on purpose — one group name per surface. Real
# authorisation in the estate is Casbin against policies IAM owns, and a
# second, differently-shaped permission model in a reference service would be a
# worse example than an obviously partial one.
LAB_ORDER_GROUP=lab-orders
BRIDGE_OPS_GROUP=lab-ops

# --- Service-to-service access ------------------------------------------------
# Presented by the bridge on /internal/* in the header the estate's gateway
# already uses for internal calls, `x-internal-api-key`. The bridge is not a
# person, so it carries a service credential rather than a user token.
#
# This is not what keeps /internal/* off the internet — Kong does not route it
# at all. It is what stops anything else already on the sandbox network reading
# every patient in the hospital.
INTERNAL_API_KEY=__GENERATE__

# --- Administrative access ----------------------------------------------------
# Bearer tokens for the endpoints that CHANGE something or that expose
# operational detail: the bridge's catalogue sync and /ops/*, and the HIS
# catalogue refresh. Held by operators and by `make sync-catalogue`.
#
# The bridge's /ops also accepts a user token from IAM, so that looking at the
# dead-letter queue does not require passing this secret around. The HIS
# catalogue refresh does not: it is run by the deployment, which has no user.
#
# Missing or empty means the protected endpoints refuse every request. That is
# on purpose: an unset credential must not be the thing that opens a door.
BRIDGE_ADMIN_TOKEN=__GENERATE__
HIS_ADMIN_TOKEN=__GENERATE__

# --- Mutual TLS on the OpenELIS hop -------------------------------------------
# This is the control that turns the FHIR link from "the request came from an
# address I recognise" into "both ends proved who they are with a certificate".
# IHE ATNA requires node authentication to be bidirectional and certificate-
# based, and prohibits PHI crossing a link that is not — which is what a
# laboratory result travelling this hop is.
#
# It needs NO change to OpenELIS. Its shared HTTP client already presents a
# client certificate (HttpClientConfig.loadKeyMaterial, from the keystore this
# repository already points it at) and already validates the server against its
# truststore. Nothing was asking it for one. `make up` issues the bridge a
# certificate and imports our CA into that truststore — the one documented
# change, and the one OpenELIS's own installation guide describes.
#
# false leaves the plaintext port serving /fhir exactly as before, which is how
# to bisect a problem: turn it off, and if the fault stays it is not TLS.
BRIDGE_MTLS_ENABLED=true
BRIDGE_MTLS_PORT=8443

# --- OpenELIS <-> Bridge FHIR integration -------------------------------------
# The bridge exposes a FHIR R4 endpoint. OpenELIS polls it for Tasks and pushes
# released results back to it. Both directions are plain HTTP inside the
# sandbox network (allowHTTP=true); production would terminate TLS here.
# Must match a SAN on the bridge's certificate: Java verifies the hostname
# AFTER it trusts the chain, so reaching it as `bridge` fails even with the
# CA imported. Set back to http://bridge:8080/fhir if MTLS is disabled.
BRIDGE_FHIR_BASE=https://bridge.openelis.org:8443/fhir
# Task.owner value OpenELIS searches for. Must match what the bridge stamps on
# the Tasks it publishes.
#
# Must be a UUID: OpenELIS calls UUID.fromString() on ids it imports, so a
# friendly slug here would blow up the order import.
#
# Must be typed Organization, NOT Practitioner. This is the laboratory's routing
# address, and OpenELIS's accessioning wizard attributes every order to the owner
# whenever that reference contains "Practitioner" — burying the real ordering
# doctor. An Organization owner lets the wizard fall through to
# ServiceRequest.requester, which is where the clinician actually is. The uuid is
# a real row in OpenELIS's own organization table (fhir_uuid).
#
# Changing this strands orders already published under the old value: they keep
# the owner they were written with, and no poll will ever ask for them again.
OE_REMOTE_SOURCE_IDENTIFIER=Organization/26a13c4c-ce5f-48d9-9283-2a2d1d2c9ce4

# What that laboratory is called.
#
# A laboratory is normally a DEPARTMENT INSIDE a hospital or clinic, not a
# separate business, so this is the hospital's own name — "Stanford Lab", not a
# product name. Set it per deployment.
#
# OpenELIS holds the authoritative copy on the same organization row the uuid
# above points at (Administration → Organization Management). Keep the two the
# same: two names for one laboratory is the drift this integration exists to
# avoid. Nothing enforces it, because the name lives in the laboratory's
# database and is theirs to change.
OE_LAB_NAME="Sandbox Hospital Lab"
# How often OpenELIS polls the bridge for new orders (ms)
OE_REMOTE_POLL_FREQUENCY=30000
# How often OpenELIS pushes accumulated result resources to the bridge (minutes)
OE_SUBSCRIBER_BACKUP_INTERVAL=1

# Which containers may call the bridge's /fhir endpoint, by hostname.
#
# This is a network-layer control because it is the ONLY one available.
# OpenELIS 3.2.1.11 cannot present a credential to a remote FHIR source: its
# FhirConfig registers a BasicAuthInterceptor only when the target URL equals
# the LOCAL FHIR store path, and there is no configuration key for remote
# source credentials at all. Requiring a token on /fhir would not secure the
# integration, it would end it. See docs/security.md.
#
# Empty disables the check and logs a warning at startup.
BRIDGE_FHIR_ALLOWED_PEERS=openelis-webapp,openelis-fhir

# --- OpenELIS published ports -------------------------------------------------
# Direct access to the webapp, bypassing OpenELIS's own proxy. Handy for
# debugging; 8080 is deliberately avoided as it commonly collides.
OE_HTTPS_PORT=8443
OE_HTTP_PORT=18080
OE_FHIR_HTTPS_PORT=8444
OE_PROXY_HTTPS_PORT=8444
OE_UI_HTTPS_PORT=443
OE_UI_HTTP_PORT=80
# The password OpenELIS's own database image seeds its admin account with.
# This is OpenELIS's value, not ours - generating a random one here would just
# mean nobody can log in. Change it in the OpenELIS UI after first login and
# update this file to match.
OE_DEFAULT_PASSWORD=__SET_ME__

# --- OpenELIS keystore/truststore (generated by the certs container) ----------
SSL_TRUSTSTORE_PATH=/etc/openelis-global/truststore
SSL_TRUSTSTORE_PASSWORD=__GENERATE__
SSL_KEYSTORE_PATH=/etc/openelis-global/keystore
SSL_KEYSTORE_PASSWORD=__GENERATE__

# --- Bridge behaviour ---------------------------------------------------------
BRIDGE_MAX_RETRIES=5
BRIDGE_RETRY_BASE_DELAY_SECONDS=2
BRIDGE_RESULT_CORRELATION_RETRY_MINUTES=15

# Largest number of Tasks one poll may return. OpenELIS searches for
# status=requested, and accepting an order moves it out of that set, so a
# capped page drains itself over successive polls instead of needing the client
# to follow a next link - which this version of OpenELIS does not do for Tasks.
BRIDGE_MAX_SEARCH_RESULTS=200

# How long a Task is withheld from the poll after being handed to the LIS.
#
# OpenELIS was observed importing the same Task twice within two seconds, which
# 409s on a client-assigned FHIR id, aborts the import, and — because the Task is
# then never acknowledged — leaves it to be re-imported every 30s indefinitely.
# One of those retries created a duplicate patient record. The defect is inside
# OpenELIS (docs/catalogue-discovery-plan.md, defect 0); the collision needs two
# overlapping deliveries, and who delivers is ours.
#
# This must exceed one import comfortably — a measured one took ~5s — or the
# lease expires mid-import and re-offers the Task to the very next poll. Set it
# to 0 to hand out every Task on every poll, which is the old behaviour and the
# way to confirm a fault is not the lease.
BRIDGE_TASK_LEASE_SECONDS=90

# --- Retention ----------------------------------------------------------------
# Three of the bridge's tables grow with traffic and nothing ever removed from
# them: the mirror of everything OpenELIS pushes, the idempotency ledger, and
# the export health history. On a busy laboratory that is unbounded growth in
# the database an outage would then be diagnosed from.
#
# Each window is set by what the data is FOR, not by a single global number:
#   received  a mirror kept so a late-arriving report can still be correlated
#   events    duplicate suppression; only useful while redelivery is plausible
#   exports   health history, read when explaining an incident
#   letters   failures a human has not yet dealt with - kept longest
#
# Nothing unprocessed is ever removed, whatever its age. 0 disables a sweep.
RETENTION_RECEIVED_DAYS=30
RETENTION_EVENTS_DAYS=14
RETENTION_EXPORT_CHECKS_DAYS=30
RETENTION_DEAD_LETTERS_DAYS=180
RETENTION_SWEEP_HOURS=24

# --- Catalogue discovery ------------------------------------------------------
# The bridge reads OpenELIS's own test menu so the HIS dropdown does not have to
# be maintained by hand. Strictly read-only.
#
# The bridge reaches OpenELIS over the `integration` network, so this is the
# compose service name, not localhost. It goes straight to Tomcat rather than
# through openelis-proxy, which sits only on the `openelis` network and is
# unreachable from here - and note the context path is /OpenELIS-Global, without
# the /api prefix the proxy rewrites in for browsers.
OE_REST_BASE_URL=https://oe.openelis.org:8443/OpenELIS-Global
# A dedicated read-only OpenELIS account. Create one in the OpenELIS UI rather
# than reusing admin: this credential lives in the bridge's environment, and it
# only ever needs to read the test menu and the export status.
OE_SERVICE_USER=__SET_ME__
OE_SERVICE_PASSWORD=__SET_ME__
OE_REST_TIMEOUT_SECONDS=180
# The sandbox serves a self-signed certificate. Must be false anywhere real.
OE_REST_ACCEPT_ANY_CERT=true
# Refuse a sync that would remove more than this share of the menu: an expired
# session returns an empty list rather than an error, and applying that would
# empty the doctor's dropdown with one button press.
CATALOGUE_MAX_SHRINK=0.30

# --- Result push monitoring ---------------------------------------------------
# OpenELIS reports the health of its own outbound push subscriptions, including
# the one pointing at the bridge. Without watching it, a laboratory that stopped
# delivering results looks exactly like one with nothing ready.
#
# Unlike the catalogue, this IS polled: export health changes minute to minute
# and nobody presses a button to ask about it.
EXPORT_CHECK_MINUTES=5
# How many of OpenELIS's own declared push cycles may pass without a success
# before the channel counts as stale. One missed push is a hiccup.
EXPORT_STALE_CYCLES=5
BRIDGE_PUBLIC_FHIR_HOST=bridge.openelis.org
